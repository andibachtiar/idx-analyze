# =============================================================================
# IDX-BEI Investment Research Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# =============================================================================

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/idx_bei
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ------------------------------------------------------------------------------
# LLM / AI CONFIGURATION
# ------------------------------------------------------------------------------

# OpenAI (Primary)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=4096

# Alternative LLM Providers (uncomment as needed)

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# vLLM (Self-hosted)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# LiteLLM Proxy
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=your-litellm-api-key

# ------------------------------------------------------------------------------
# AI AGENT CONFIGURATION
# ------------------------------------------------------------------------------

# Agent Behavior
AGENT_SYSTEM_PROMPT=You are a professional investment research analyst for Indonesian stocks (IDX/BEI).
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120

# Analysis Preferences
DEFAULT_ANALYSIS_HORIZON=MEDIUM
DEFAULT_CONFIDENCE_THRESHOLD=0.7
ENABLE_TOOL_CALLING=true
ENABLE_STRUCTURED_OUTPUT=true

# Rate Limiting
LLM_RATE_LIMIT_REQUESTS_PER_MINUTE=60
LLM_RATE_LIMIT_TOKENS_PER_MINUTE=100000

# ------------------------------------------------------------------------------
# STOCK DATA SOURCES
# ------------------------------------------------------------------------------

# Yahoo Finance
YAHOO_FINANCE_ENABLED=true
YAHOO_FINANCE_PROXY=

# IDX (Indonesian Stock Exchange)
IDX_SCRAPER_ENABLED=true
IDX_API_URL=https://www.idx.co.id
IDX_DATA_DIR=./data/idx

# News Sources
NEWS_API_KEY=your-news-api-key
NEWS_ENABLED=true
NEWS_SOURCES=cnbc_indonesia,bisnis_com,antara_news

# ------------------------------------------------------------------------------
# VECTOR DATABASE (for RAG)
# ------------------------------------------------------------------------------

VECTOR_STORE_TYPE=chroma  # chroma, qdrant, weaviate, pgvector
CHROMA_PATH=./data/chroma_db
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
PGVECTOR_URL=postgresql://user:password@localhost:5432/idx_bei_vectors

# ------------------------------------------------------------------------------
# DOCUMENT PROCESSING
# ------------------------------------------------------------------------------

DOCUMENT_UPLOAD_DIR=./data/uploads
MAX_DOCUMENT_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.txt

# ------------------------------------------------------------------------------
# API SERVER
# ------------------------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_CORS_ORIGINS=["*"]

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------

LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------

SECRET_KEY=change-me-in-production-use-random-string
JWT_SECRET_KEY=change-me-in-production-use-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# CACHING
# ------------------------------------------------------------------------------

CACHE_ENABLED=true
CACHE_TYPE=memory  # memory, redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# SCHEDULER (for periodic data fetching)
# ------------------------------------------------------------------------------

SCHEDULER_ENABLED=true
SCHEDULER_STOCK_PRICE_INTERVAL_MINUTES=5
SCHEDULER_FINANCIAL_DATA_INTERVAL_HOURS=24
SCHEDULER_NEWS_INTERVAL_MINUTES=15
